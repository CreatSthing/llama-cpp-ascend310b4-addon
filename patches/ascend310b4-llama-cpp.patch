+template <typename T>
+static void set_input_kv_lengths_impl(ggml_tensor * dst, const ggml_tensor * mask, const T * data) {
+    const int64_t n_kv = mask->ne[0];
+    const int64_t n_rows = ggml_nelements(mask) / n_kv;
+    GGML_ASSERT(ggml_nelements(dst) == n_rows);
+
+    std::vector<int32_t> lengths(n_rows);
+    for (int64_t row = 0; row < n_rows; ++row) {
+        int64_t length = n_kv;
+        while (length > 0 && !std::isfinite(llama_cast<float>(data[row*n_kv + length - 1]))) {
+            --length;
+        }
+        lengths[row] = static_cast<int32_t>(std::max<int64_t>(length, 1));
+    }
+
+    ggml_backend_tensor_set(dst, lengths.data(), 0, lengths.size() * sizeof(lengths[0]));
+}
+
+static void set_input_kv_lengths(ggml_tensor * dst, const ggml_tensor * mask) {
+    GGML_ASSERT(dst && mask);
+    GGML_ASSERT(dst->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_backend_buffer_is_host(mask->buffer));
+
+    if (mask->type == GGML_TYPE_F16) {
+        set_input_kv_lengths_impl(dst, mask, (const ggml_fp16_t *) mask->data);
+    } else {
+        GGML_ASSERT(mask->type == GGML_TYPE_F32);
+        set_input_kv_lengths_impl(dst, mask, (const float *) mask->data);
+    }
